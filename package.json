{
  "name": "youtube-studio-guion",
  "version": "0.2.0",
  "description": "Estudio local en Electron para convertir guiones por diapositivas en videos de YouTube.",
  "main": "main.js",
  "author": "jeffer91",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir",
    "test": "node tests/run-all.js"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.jeffer91.youtubestudio",
    "productName": "YouTube Studio IA",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
